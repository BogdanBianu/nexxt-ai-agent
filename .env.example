# Copiază acest fișier în .env și pune credențialele AWS Bedrock ale echipei
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model AWS Bedrock (us-west-2)
LLM_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# "auto" = folosește AWS Bedrock dacă AWS_ACCESS_KEY_ID este setat, altfel cade pe reguli deterministe
# "off"  = forțează modul determinist (util pentru teste rapide sau dacă pică netul la demo)
USE_LLM=auto

# Telemetrie AI & ROI (dashboard Executive Impact): curs USD->EUR și costul muncii manuale per dosar
USD_EUR_RATE=0.92
OFFICER_MINUTES_PER_CASE=15
OFFICER_HOURLY_COST_EUR=15
