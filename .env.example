# Copiază acest fișier în .env și pune cheia voastră de la Featherless.ai
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# "auto" = folosește LLM dacă FEATHERLESS_API_KEY este setat, altfel cade pe reguli deterministe
# "off"  = forțează modul determinist (util pentru teste rapide sau dacă pică netul la demo)
USE_LLM=auto
